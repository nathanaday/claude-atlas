{
  "collapse-filter": false,
  "search": "-path:Overview.md -path:About.md -path:Reference.md",
  "showTags": false,
  "showAttachments": false,
  "hideUnresolved": false,
  "showOrphans": true,
  "collapse-color-groups": false,
  "colorGroups": [
    { "query": "path:tree/", "color": { "a": 1, "rgb": 5213943 } },
    { "query": "path:categories/ OR path:Tree.md", "color": { "a": 1, "rgb": 9342611 } },
    { "query": "path:repos/", "color": { "a": 1, "rgb": 3459929 } },
    { "query": "path:materials/", "color": { "a": 1, "rgb": 16752394 } }
  ],
  "collapse-display": true,
  "showArrow": false,
  "textFadeMultiplier": 0,
  "nodeSizeMultiplier": 1,
  "lineSizeMultiplier": 1,
  "collapse-forces": true,
  "centerStrength": 0.5,
  "repelStrength": 10,
  "linkStrength": 1,
  "linkDistance": 250,
  "scale": 1,
  "close": false
}
